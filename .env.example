# ─────────────────────────────────────────────────────────────────────────────
# Memorable Stories — variables de entorno
# Copiar a `.env.local` y rellenar. NUNCA commitear `.env.local`.
# Ninguna de estas puede llevar el prefijo NEXT_PUBLIC_: Next.js las inlinearía
# en el bundle del cliente en build time, y eso es irreversible una vez desplegado.
# ─────────────────────────────────────────────────────────────────────────────

# ── Guion ────────────────────────────────────────────────────────────────────
# Modelo: claude-opus-5 (structured outputs para el JSON escena-por-escena)
ANTHROPIC_API_KEY=sk-ant-...

# ── Voz y subtítulos ─────────────────────────────────────────────────────────
# El endpoint /with-timestamps devuelve audio Y alineación por carácter en una
# sola llamada: no hace falta Whisper ni ningún STT.
ELEVENLABS_API_KEY=
# ⚠️ Las "Default voices" de ElevenLabs EXPIRAN el 31/12/2026.
# Guardar los IDs aquí o en base de datos, nunca hardcodeados en el código.
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_EN=

# ── Video generativo ─────────────────────────────────────────────────────────
# Formato de auth literal: `Authorization: Key {key}:{secret}`
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Coste por crédito según plan: 0.033 (Ultra anual) · 0.049 (Plus mensual)
HIGGSFIELD_CREDIT_USD=0.033
HIGGSFIELD_MODEL_ID=higgsfield-ai/dop/standard

# Fallbacks verificados (opcionales)
KLING_API_KEY=
LUMA_AGENTS_API_KEY=
RUNWAYML_API_SECRET=

# ── Imagen generativa (Nano Banana — API de Gemini) ──────────────────────────
# Solo para lo que NINGÚN archivo puede mostrar: objetos sin foto libre,
# lugares vacíos y sobre todo diagramas. Ver §6 de scripts-out/03-motorola-plan.md.
#
# Auth por cabecera `x-goog-api-key`, no por `?key=` — una clave en la query
# string acaba en logs de acceso, historial de shell y cualquier proxy.
#
# ⚠️ Facturación de PREPAGO. Sin saldo, la API devuelve 429 RESOURCE_EXHAUSTED
#    con el mismo código que un rate limit; se distinguen solo por el mensaje.
#    Recarga en https://ai.studio/projects
#
# ⚠️ Toda imagen sale con marca de agua SynthID y NO es material de archivo.
#    El pipeline la registra en `imagenes-generadas.json`, nunca en
#    `assets-curados.json`, y el render la cuenta aparte. Ver
#    src/lib/production/generated-images.ts.
#
# Resolución: `assets/resolution.ts` exige ≥2.500 px de ancho para mover la
# cámara sobre una fija a 1080p. En 16:9 solo el escalón 4K llega, así que 4K
# es el mínimo utilizable y no una preferencia de calidad.
GEMINI_API_KEY=
# Modelos verificados contra /v1beta/models el 31/07/2026:
#   gemini-3.1-flash-image       Nano Banana 2       4K ~$0.151/img   (por defecto)
#   gemini-3-pro-image           Nano Banana Pro     4K ~$0.24/img    (texto legible)
#   gemini-3.1-flash-lite-image  Nano Banana 2 Lite  1K ~$0.034/img   (solo 1K)
#   gemini-2.5-flash-image       Nano Banana         1K ~$0.039/img

# ── Almacenamiento (Cloudflare R2 — egress $0) ───────────────────────────────
# ⚠️ Higgsfield borra los assets a los 7 días. Copiar aquí en el webhook.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=memorablestories

# ── Base de datos (Supabase Postgres) ────────────────────────────────────────
# Rutas de Next.js → Supavisor transaction mode, puerto 6543, prepare:false
# Worker long-lived → session mode, puerto 5432
DATABASE_URL=
DIRECT_URL=

# ── Orquestación ─────────────────────────────────────────────────────────────
TRIGGER_SECRET_KEY=tr_dev_...
TRIGGER_PROJECT_ID=

# ── Publicación en YouTube ───────────────────────────────────────────────────
# Scope mínimo: https://www.googleapis.com/auth/youtube.upload
#   (cubre videos.insert Y thumbnails.set — menos scopes = verificación más rápida)
#
# ⚠️ DOS trámites distintos, ambos bloqueantes:
#   1. YouTube API Services - Audit and Quota Extension Form
#      → sin esto TODOS los videos quedan en `private` de forma PERMANENTE,
#        sin posibilidad de apelación. Enviarlo el día 1.
#   2. OAuth App Verification (Google Cloud) → pasar a "In production"
#      → en modo "Testing" el refresh token EXPIRA CADA 7 DÍAS.
#
# ⚠️ Usar OAuth clients SEPARADOS para dev y prod: el límite de 100 refresh
#    tokens por cuenta/client invalida el token más antiguo sin aviso.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# ── Cifrado de tokens OAuth en reposo ────────────────────────────────────────
# 32 bytes en hex para AES-256-GCM. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Ingesta de ideas ─────────────────────────────────────────────────────────
# Wikimedia exige un User-Agent identificativo: 200 req/min con él, 10 sin él.
WIKIMEDIA_USER_AGENT=MemorableStories/0.1 (https://github.com/RasheedBayter/memorablestories)

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
